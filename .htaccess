Options -Indexes

# Never serve local configuration, logs, database exports, or temporary scripts.
<FilesMatch "^(\.env|.*\.sql|.*\.local\.php|tmp_.*\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^Front-end/uploads/writing/[^/]+\.png$ - [L,NC]
    RewriteRule ^(backend/logs|Front-end/backend|Front-end/uploads)(/|$) - [F,L]
</IfModule>